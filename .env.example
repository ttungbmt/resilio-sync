# Copy to .env and fill in real values. See docs/research/resilio-sync-docker.md.

# Image tag: pin to a linuxserver version tag (https://hub.docker.com/r/linuxserver/resilio-sync/tags)
RESILIO_TAG=3.1.2

# Host user/group that owns ./data (output of `id -u` / `id -g`)
PUID=1000
PGID=1000
UMASK=022
TZ=Etc/UTC

# Web UI: keep on loopback; use an SSH tunnel or reverse proxy for remote access
WEBUI_BIND=127.0.0.1
WEBUI_PORT=8888

# Sync listening port: must match "listening_port" in data/config/sync.conf.
# Keep it below 49152: on Windows hosts (Docker Desktop / WSL2), Hyper-V reserves
# random ranges in 49152-65535, and the default 55555 can land in one of them.
SYNC_PORT=44555

# Host paths
CONFIG_DIR=./data/config
SYNC_DIR=./data/sync
DOWNLOADS_DIR=./data/downloads
